{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/360/versions",
      "dest": "/api/index.js"
    },
    {
      "src": "/login1",
      "dest": "/api/index.js"
    },
    {
      "src": "/360/login13",
      "dest": "/api/index.js"
    },
    {
      "src": "/360/credit1234567",
      "dest": "/api/index.js"
    },
    {
      "src": "/smarttool-api/?(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
