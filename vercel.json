{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/360/v",
      "dest": "/api/index.js",
      "methods": ["GET"]
    },
    {
      "src": "/360/l",
      "dest": "/api/index.js",
      "methods": ["POST"]
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
